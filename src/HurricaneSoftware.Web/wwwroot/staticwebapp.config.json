{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/_framework/*",
      "/css/*",
      "/js/*",
      "/*.css",
      "/*.js",
      "/*.png",
      "/*.jpg",
      "/*.gif",
      "/*.svg",
      "/*.ico",
      "/*.zip",
      "/downloads/*",
      "/appsettings.json"
    ]
  },
  "globalHeaders": {
    "X-Frame-Options": "DENY",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
