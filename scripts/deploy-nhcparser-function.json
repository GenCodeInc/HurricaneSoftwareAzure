    "sqlPrivateDnsZoneGroupName": {
      "type": "string",
      "defaultValue": "sql-dns-zone-group"
    },
    "vnetRouteAllEnabled": {
      "type": "bool",
      "defaultValue": true
    }
  },
  "variables": {
