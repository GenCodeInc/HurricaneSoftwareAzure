AZURE_SUBSCRIPTION_ID=<sub id>
AZURE_RESOURCE_GROUP=<resource group>
AZURE_REGION=centralus

# Must be globally unique across Azure.
AZURE_SQL_SERVER_NAME=<sql server name>

# Azure SQL logical server admin.
AZURE_SQL_ADMIN_USER=sqladminuser
AZURE_SQL_ADMIN_PASSWORD=<pwd>

# Cheapest always-on option for light usage.
AZURE_SQL_SERVICE_OBJECTIVE=Basic

# Lowest-cost backup redundancy tier.
AZURE_SQL_BACKUP_STORAGE_REDUNDANCY=Local

# Set to true if Azure-hosted apps will also need access.
AZURE_SQL_ALLOW_AZURE_SERVICES=true

# Optional Function App names. Leave blank to let the deployment generate unique names.
AZURE_FUNCTION_APP_NAME=
AZURE_FUNCTION_PLAN_NAME=
AZURE_FUNCTION_STORAGE_ACCOUNT_NAME=

# Optional API App Service names. Set these in your local .env to keep live names out of git.
AZURE_API_APP_NAME=
AZURE_API_PLAN_NAME=
AZURE_API_VNET_NAME=
AZURE_API_INTEGRATION_SUBNET_NAME=

# Optional Static Web App name for the separate HurricaneSoftware public website.
AZURE_STATIC_WEB_APP_NAME=

# Optional ACS settings for website-originated email on TropicalStorms.Api.
# If AZURE_WEBSITE_ACS_CONNECTION_STRING is blank but AZURE_WEBSITE_ACS_COMMUNICATION_SERVICE_NAME is set,
# deploy-tropicalstorms-api.ps1 will fetch the primary connection string from Azure CLI.
AZURE_WEBSITE_ACS_COMMUNICATION_SERVICE_NAME=
AZURE_WEBSITE_ACS_CONNECTION_STRING=
AZURE_WEBSITE_ACS_SENDER_ADDRESS=
AZURE_WEBSITE_ACS_SENDER_DISPLAY_NAME=Tracking The Eye
AZURE_WEBSITE_ACS_ADMIN_ADDRESS=www@gencode.com

# Flex Consumption parser Function settings.
AZURE_FUNCTION_TIMER_SCHEDULE=0 */5 * * * *
AZURE_FUNCTION_MAXIMUM_INSTANCE_COUNT=100
AZURE_FUNCTION_INSTANCE_MEMORY_MB=512
AZURE_FUNCTION_ALWAYS_READY_FUNCTION_NAME=NHCParserTimer
AZURE_FUNCTION_ALWAYS_READY_INSTANCE_COUNT=1
AZURE_FUNCTION_CURRENT_YEAR_ONLY=true
AZURE_FUNCTION_PROBE_DATABASE_ON_STARTUP=false

# Local-only SMTP probe settings for .scratch/SmtpProbe.
SMTP_PROBE_FROM=
SMTP_PROBE_PASSWORD=
SMTP_PROBE_HOST=
SMTP_PROBE_PORT=587
SMTP_PROBE_TO=